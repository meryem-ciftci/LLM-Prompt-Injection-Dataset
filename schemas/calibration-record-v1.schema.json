{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meryem-ciftci/LLM-Prompt-Injection-Dataset/schemas/calibration-record-v1.schema.json",
  "title": "Dataset Generator 2 Calibration Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "schema_version", "language", "scenario", "user_task",
    "source", "carrier_text", "label", "injection_spans",
    "trust_boundary_decision", "decision_rationale", "ambiguity_reason",
    "annotation_status", "provenance", "safety"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^CAL-(INJ|BEN|BOR)-[0-9]{3}$"},
    "schema_version": {"const": "1.0.0"},
    "language": {"enum": ["tr", "en"]},
    "scenario": {"type": "string", "minLength": 1},
    "user_task": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "role", "trust_level"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "role": {"enum": ["external_content", "authorized_user"]},
        "trust_level": {"enum": ["untrusted_content", "trusted_instruction", "mixed_or_unspecified"]}
      }
    },
    "carrier_text": {"type": "string", "minLength": 1},
    "label": {"enum": ["injection", "benign", "borderline"]},
    "injection_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "span_type", "text"],
        "properties": {
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 1},
          "span_type": {"const": "injected_instruction"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "trust_boundary_decision": {"type": "string", "minLength": 1},
    "decision_rationale": {"type": "string", "minLength": 1},
    "ambiguity_reason": {"type": ["string", "null"]},
    "annotation_status": {"enum": ["gold_calibration", "adjudication_required", "double_annotated", "human_verified"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "author_role", "created_date", "license_intent", "external_source", "contains_real_personal_data"],
      "properties": {
        "origin": {"const": "human_authored_synthetic"},
        "author_role": {"type": "string"},
        "created_date": {"type": "string", "format": "date"},
        "license_intent": {"type": "string"},
        "external_source": {"type": ["string", "null"]},
        "contains_real_personal_data": {"const": false}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fictional", "live_secret", "executable_payload"],
      "properties": {
        "fictional": {"const": true},
        "live_secret": {"const": false},
        "executable_payload": {"const": false}
      }
    }
  }
}
