# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Sanal Ortamlar
venv/
.venv/
env/

# Üretilen veri dosyaları (Github'a yüklenmemesi gereken çıktılar)
processed_dataset.jsonl
*.parquet

# Legacy generated datasets remain recoverable from Git history, not the active tree
data/generated/dataset_v2.jsonl
data/generated/dataset_v2.manifest.json
data/generated/dataset_v2_1.jsonl
data/generated/dataset_v2_1.manifest.json

# Experiment outputs are local/release artifacts; register experiments in README
evaluation/results/*
evaluation/reports/*
!evaluation/results/.gitkeep
!evaluation/reports/.gitkeep
# Registered, completed experiments are kept for reproducibility
!evaluation/results/EXP-003__*.jsonl
!evaluation/results/run_log.jsonl
!evaluation/reports/EXP-003.*

# IDE ve Sistem Dosyaları
.vscode/
.idea/
.DS_Store
Thumbs.db

# Raw third-party corpora and derived carrier text (G3): only IDs and hashes are committed
data/raw/

# local model working files (QC summary of accepted components is kept in data/attack_components)
data/proposals/
data/attack_components/_superseded/
review.csv
